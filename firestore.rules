rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function memberDoc() { return get(/databases/$(database)/documents/members/$(request.auth.uid)); }
    function isAdmin() { return signedIn() && memberDoc().data.role == "Admin"; }
    function isOfficer() { return signedIn() && (memberDoc().data.role == "Officer" || memberDoc().data.role == "Admin"); }

    match /members/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == "Member";
      allow update: if isAdmin()
        || (signedIn() && request.auth.uid == uid
            && request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }

    match /courses/{id} {
      allow read: if signedIn();
      allow create, update, delete: if isOfficer();
    }

    match /sessions/{id} {
      allow read: if signedIn();
      allow create, update, delete: if isOfficer();
    }

    match /attendance/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.memberUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.memberUid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /reminders/{id} {
      allow read: if signedIn();
      allow create, update, delete: if isOfficer();
    }

    match /mail/{id} {
      allow create: if isOfficer();
      allow read, update, delete: if isAdmin();
    }
  }
}
